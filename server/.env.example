PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/researchx_ai?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_64_char_random_hex_secret
JWT_EXPIRES_IN=7d

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
TAVILY_API_KEY=your_tavily_api_key_here

CLIENT_URL=http://localhost:5173

MAX_UPLOAD_SIZE_MB=10
AGENT_MAX_ITERATIONS_QUICK=6
AGENT_MAX_ITERATIONS_STANDARD=10
AGENT_MAX_ITERATIONS_DEEP=16
TOOL_TIMEOUT_MS=15000
USE_IN_MEMORY_DB=false
