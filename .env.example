# ===========================================
# RESEARCHX AI - Environment Configuration
# ===========================================
# Copy server/.env.example to server/.env and client/.env.example to client/.env

# --- Backend (server/.env) ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/researchx_ai?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_64_char_random_hex_secret
JWT_EXPIRES_IN=7d

# Google Gemini API (Backend Only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Tavily Web Search API (Backend Only)
TAVILY_API_KEY=your_tavily_api_key_here

# CORS & Frontend URL
CLIENT_URL=http://localhost:5173

# Limits & Agent Controls
MAX_UPLOAD_SIZE_MB=10
AGENT_MAX_ITERATIONS_QUICK=6
AGENT_MAX_ITERATIONS_STANDARD=10
AGENT_MAX_ITERATIONS_DEEP=16
TOOL_TIMEOUT_MS=15000

# Optional: Set to true only for local offline testing without MongoDB installed
USE_IN_MEMORY_DB=false

# --- Frontend (client/.env) ---
VITE_API_URL=http://localhost:5000/api
